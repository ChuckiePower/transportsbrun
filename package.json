{
  "name": "transports-brun",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de Transports Brun (Saint-Hippolyte, Haut-Rhin) — Next.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "check:site": "node scripts/check-site.mjs",
    "test:e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@radix-ui/react-dialog": "1.3.1",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "lucide-react": "1.59.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
