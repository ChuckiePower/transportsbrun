# Copier ce fichier en .env (production) ou .env.local (développement) et compléter.
# Ne JAMAIS committer le fichier rempli.

# URL publique du site, sans slash final (canonical, sitemap, Open Graph, contrôle d'origine)
SITE_URL=https://transports-brun.com

# --- Envoi des demandes de devis (SMTP) ---------------------------------------
# Sur le serveur, préférez : bash scripts/configurer.sh (questions une à une, mot de passe masqué).
# Messagerie du domaine chez Infomaniak : SMTP_HOST=mail.infomaniak.com.
# Port 465 + SMTP_SECURE=true (SSL) ou port 587 + SMTP_SECURE=false (STARTTLS).
# DMARC du domaine en p=reject : CONTACT_FROM doit être la boîte authentifiée (= SMTP_USER).
# Sans SMTP_HOST : en développement l'e-mail est affiché dans la console ;
# en production le formulaire répond « envoi impossible » (aucune demande perdue en silence).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Expéditeur : doit être une adresse autorisée par le serveur SMTP (souvent = SMTP_USER)
CONTACT_FROM=
# Destinataire des demandes
CONTACT_TO=contact@transports-brun.com

# --- Anti-abus du formulaire --------------------------------------------------
# Nombre d'envois autorisés par adresse IP et par fenêtre (ms)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# --- Mesure d'audience (facultative, désactivée si vide) ----------------------
# Outils auto-hébergés sans cookie uniquement. Valeurs lues AU BUILD.
# ANALYTICS_PROVIDER=umami          ou plausible
# ANALYTICS_SCRIPT_URL=https://stats.transports-brun.com/script.js
# ANALYTICS_SITE_ID=<identifiant du site Umami>   (Plausible : le domaine, ex. transports-brun.com)
ANALYTICS_PROVIDER=
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=

# --- Tests uniquement -----------------------------------------------------------
# MAIL_OUTBOX_FILE=.playwright/outbox.jsonl
